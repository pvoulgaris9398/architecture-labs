# Copy this file to .env and replace local credentials before starting the stack.

SEQ_ADMIN_USER=admin
SEQ_ADMIN_PASSWORD=replace_with_local_seq_password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_local_grafana_password

SEQ_HOST_PORT=5341
JAEGER_HOST_PORT=16686
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000

API_OTEL_GRPC_HOST_PORT=14317
API_OTEL_HTTP_HOST_PORT=14318
API_OTEL_HEALTH_HOST_PORT=13133
API_OTEL_METRICS_HOST_PORT=18888

DISTRIBUTED_OTEL_GRPC_HOST_PORT=4317
DISTRIBUTED_OTEL_HTTP_HOST_PORT=4318

SEQ_IMAGE=datalust/seq:2026.1.17004-x64
JAEGER_IMAGE=jaegertracing/jaeger:2.19.0
PROMETHEUS_IMAGE=prom/prometheus:v3.5.5
GRAFANA_IMAGE=grafana/grafana:13.1.1
API_OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.157.0
DISTRIBUTED_OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.156.0
