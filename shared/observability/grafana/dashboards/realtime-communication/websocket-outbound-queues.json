{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "targets": [{ "expr": "websocket_connections_active", "legendFormat": "active" }],
      "title": "Active connections",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "targets": [
        { "expr": "websocket_outbound_queue_depth", "legendFormat": "depth" },
        { "expr": "websocket_outbound_queue_capacity", "legendFormat": "capacity" }
      ],
      "title": "Aggregate outbound queue",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "targets": [
        { "expr": "sum by (message_type) (rate(websocket_outbound_messages_enqueued_total[1m]))", "legendFormat": "enqueued {{message_type}}" },
        { "expr": "sum by (message_type) (rate(websocket_outbound_messages_sent_total[1m]))", "legendFormat": "sent {{message_type}}" }
      ],
      "title": "Outbound message rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, message_type) (rate(websocket_outbound_queue_delay_milliseconds_bucket[1m])))", "legendFormat": "p95 {{message_type}}" }],
      "title": "Queue delay p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "targets": [
        { "expr": "sum by (message_type) (rate(websocket_outbound_backpressure_waits_total[1m]))", "legendFormat": "waits {{message_type}}" },
        { "expr": "sum by (error_type) (rate(websocket_outbound_send_failures_total[1m]))", "legendFormat": "failures {{error_type}}" }
      ],
      "title": "Backpressure waits and send failures",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": ["architecture-labs", "websocket", "backpressure"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "WebSocket outbound queues",
  "uid": "realtime-websocket-outbound",
  "version": 1
}
