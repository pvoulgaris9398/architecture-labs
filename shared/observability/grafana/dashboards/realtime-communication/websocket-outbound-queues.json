{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "targets": [{ "expr": "{__name__=\"websocket.connections.active\"}", "legendFormat": "{{connection_mode}}" }],
      "title": "Active connections",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "targets": [
        { "expr": "{__name__=\"websocket.outbound.queue.depth\"}", "legendFormat": "depth {{connection_mode}}" },
        { "expr": "{__name__=\"websocket.outbound.queue.capacity\"}", "legendFormat": "capacity {{connection_mode}}" }
      ],
      "title": "Aggregate outbound queue",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "targets": [
        { "expr": "sum by (connection_mode, message_type) (rate({__name__=\"websocket.outbound.messages.enqueued_total\"}[1m]))", "legendFormat": "enqueued {{connection_mode}} {{message_type}}" },
        { "expr": "sum by (connection_mode, message_type) (rate({__name__=\"websocket.outbound.messages.sent_total\"}[1m]))", "legendFormat": "sent {{connection_mode}} {{message_type}}" }
      ],
      "title": "Outbound message rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, connection_mode, message_type) (rate({__name__=\"websocket.outbound.queue.delay_milliseconds_bucket\"}[1m])))", "legendFormat": "p95 {{connection_mode}} {{message_type}}" }],
      "title": "Queue delay p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "targets": [
        { "expr": "sum by (connection_mode, message_type) (rate({__name__=\"websocket.outbound.backpressure.waits_total\"}[1m]))", "legendFormat": "waits {{connection_mode}} {{message_type}}" },
        { "expr": "sum by (error_type) (rate({__name__=\"websocket.outbound.send.failures_total\"}[1m]))", "legendFormat": "failures {{error_type}}" }
      ],
      "title": "Backpressure waits and send failures",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": ["architecture-labs", "websocket", "backpressure"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "WebSocket outbound queues",
  "uid": "realtime-websocket-outbound",
  "version": 1
}
