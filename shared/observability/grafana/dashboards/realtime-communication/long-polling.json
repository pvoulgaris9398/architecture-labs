{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "targets": [{ "expr": "{__name__=\"long_poll.requests.active\"}", "legendFormat": "active" }],
      "title": "Active held requests",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "targets": [{ "expr": "sum by (outcome) (rate({__name__=\"long_poll.requests.completed_total\"}[1m]))", "legendFormat": "{{outcome}}" }],
      "title": "Completed request rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate({__name__=\"long_poll.wait.duration_milliseconds_bucket\"}[5m])))", "legendFormat": "p95" }],
      "title": "Wait duration p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "expr": "sum by (outcome) ({__name__=\"long_poll.requests.completed_total\"})", "legendFormat": "{{outcome}}" }],
      "title": "Completed requests (total)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "id": 5,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "expr": "sum({__name__=\"long_poll.events.returned_total\"})", "legendFormat": "events" }],
      "title": "Events returned (total)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "id": 6,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "expr": "sum({__name__=\"long_poll.requests.completed_total\", outcome=\"timeout\"})", "legendFormat": "timeouts" }],
      "title": "Timed-out polls (total)",
      "type": "stat"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": ["architecture-labs", "long-polling", "http"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "Long polling requests",
  "uid": "realtime-long-polling",
  "version": 1
}
