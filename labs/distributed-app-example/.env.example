# Copy this file to .env before running the lab. Replace demonstration credentials locally.

# Host ports
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
API_HOST_PORT=5242
DASHBOARD_HOST_PORT=5173

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=db_ecommerce
POSTGRES_USER=replace_with_local_user
POSTGRES_PASSWORD=replace_with_local_password

# Redis and gRPC service discovery
REDIS_ENDPOINT=redis:6379
GRPC_INVENTORY_URL=http://python-grpc-inventory:50051

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=replace_with_local_user
RABBITMQ_PASSWORD=replace_with_local_password

# Telemetry and dashboards
OTEL_EXPORTER_OTLP_ENDPOINT=http://distributed-app-collector:4317

# This URL is embedded into the browser bundle during the dashboard image build.
VITE_API_BASE_URL=http://127.0.0.1:5242
