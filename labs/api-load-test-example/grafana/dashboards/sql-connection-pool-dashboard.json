{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Active Execution Latency (P95 HTTP Request Duration) by Endpoint",
      "type": "timeseries",
      "id": 1,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate({__name__=\"http.server.request.duration_seconds_bucket\", \"http.route\"=~\"$endpoint\"}[1m])) by (le, \"http.route\"))",
          "legendFormat": "P95 - {{http.route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "s"
        }
      }
    },

    {
      "title": "Connection Pool: Active vs Free vs Stasis",
      "description": "Active = connections currently in use by the app. Free = available in pool. Stasis = awaiting completion of an action (pool pressure indicator).",
      "type": "timeseries",
      "id": 2,
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "{__name__=\"sqlclient.pool.connections_in_use\"}",
          "legendFormat": "In Use"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "{__name__=\"sqlclient.pool.connections_free\"}",
          "legendFormat": "Free"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "{__name__=\"sqlclient.pool.connections_stasis\"}",
          "legendFormat": "Stasis (pool pressure)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Stasis (pool pressure)" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
            ]
          }
        ]
      }
    },

    {
      "title": "API HTTP 5xx Rate (Server-side)",
      "description": "Responses returned with a 5xx status. TCP connection failures never reach the API and are shown separately by the k6 Client Failure Ratio panel.",
      "type": "stat",
      "id": 3,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(rate({__name__=\"http.server.request.duration_seconds_count\", \"http.route\"=~\"$endpoint\", \"http.response.status_code\"=~\"5..\"}[1m])) or vector(0)",
          "legendFormat": "Failures / sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },

    {
      "title": "Pool Anomalies: Stasis and Reclaimed Connections",
      "description": "Stasis means a connection is awaiting completion of an action, commonly transaction-related; it is not a count of requests queued for a pool slot. Reclaimed connections indicate SqlConnections collected without Close or Dispose.",
      "type": "timeseries",
      "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "{__name__=\"sqlclient.pool.connections_stasis\"}",
          "legendFormat": "Stasis (queued, blocked)"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "{__name__=\"sqlclient.pool.reclaimed_connections\"}",
          "legendFormat": "Reclaimed by GC (leak indicator)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60 },
          "color": { "mode": "fixed", "fixedColor": "red" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },

    {
      "title": "Physical Connection Churn (Hard Connects / Disconnects per sec)",
      "description": "Hard connects/disconnects should be near zero under steady load — the pool should be reusing soft connections. A spike here means the pool is being exhausted and new physical connections are being opened.",
      "type": "timeseries",
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "{__name__=\"sqlclient.connections.hard_connects\"}",
          "legendFormat": "Hard Connects / sec"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "{__name__=\"sqlclient.connections.hard_disconnects\"}",
          "legendFormat": "Hard Disconnects / sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Hard Disconnects / sec" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }
            ]
          }
        ]
      }
    },

    {
      "title": "Pool Soft Connect/Disconnect Rate (Pool Reuse)",
      "description": "Soft connects/disconnects represent normal pool checkout/return activity. A healthy pool has high soft rates and near-zero hard rates.",
      "type": "timeseries",
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "{__name__=\"sqlclient.pool.soft_connects\"}",
          "legendFormat": "Pool Checkouts / sec"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "{__name__=\"sqlclient.pool.soft_disconnects\"}",
          "legendFormat": "Pool Returns / sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" }
        }
      }
    },

    {
      "title": "Pool Inventory Snapshot",
      "description": "Total pooled connections managed by the driver vs non-pooled (should be 0 unless Pooling=false connections exist).",
      "type": "timeseries",
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "{__name__=\"sqlclient.pool.pooled_connections\"}",
          "legendFormat": "Pooled Connections"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "{__name__=\"sqlclient.pool.non_pooled_connections\"}",
          "legendFormat": "Non-Pooled Connections"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "{__name__=\"sqlclient.connections.active_hard\"}",
          "legendFormat": "Active Physical Connections"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" }
        }
      }
    },

    {
      "title": "API Scrape Availability",
      "description": "Prometheus target availability sampled every five seconds. A brief listener failure between scrapes can still be missed; compare with the k6 client failure panel.",
      "type": "timeseries",
      "id": 8,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "up{job=\"csharp-api\"}",
          "legendFormat": "API up"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 20 }
        }
      }
    },

    {
      "title": "Server Active HTTP Requests",
      "description": "Requests currently executing inside ASP.NET Core. Connection attempts rejected before acceptance are not included.",
      "type": "timeseries",
      "id": 9,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 32 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum({__name__=\"http.server.active_requests\"})",
          "legendFormat": "Active requests"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 20 } } }
    },

    {
      "title": "k6 Client Failure Ratio",
      "description": "Client-observed failures, including TCP connection refusals, when k6 is run through run-k6.sh with Prometheus remote write enabled.",
      "type": "timeseries",
      "id": 10,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 32 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "max({__name__=\"k6_http_req_failed_rate\"}) or vector(0)",
          "legendFormat": "Failed request ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "fillOpacity": 30 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      }
    },

    {
      "title": "k6 Virtual Users",
      "type": "timeseries",
      "id": 11,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 40 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum({__name__=\"k6_vus\"}) or vector(0)",
          "legendFormat": "VUs"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 20 } } }
    },

    {
      "title": "k6 Request Rate",
      "type": "timeseries",
      "id": 12,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 40 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(rate({__name__=\"k6_http_reqs_total\"}[30s])) or vector(0)",
          "legendFormat": "Requests / sec"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20 } } }
    },

    {
      "title": "Connection Pool Utilization",
      "description": "Connections in use as a percentage of the active connection string's Max Pool Size of 150.",
      "type": "timeseries",
      "id": 13,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 40 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "100 * {__name__=\"sqlclient.pool.connections_in_use\"} / 150",
          "legendFormat": "Pool utilization"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "fillOpacity": 25 }
        }
      }
    },

    {
      "title": "Average SQL Client Operation Duration",
      "description": "Rate-derived average from the OpenTelemetry SQL client duration histogram, grouped by database.",
      "type": "timeseries",
      "id": 14,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 48 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum by (\"db.name\") (rate({__name__=\"db.client.operation.duration_seconds_sum\"}[1m])) / sum by (\"db.name\") (rate({__name__=\"db.client.operation.duration_seconds_count\"}[1m]))",
          "legendFormat": "{{db.name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 15 } } }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["sql-server", "opentelemetry", "dotnet"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus" },
        "definition": "label_values({__name__=\"http.server.request.duration_seconds_count\"}, \"http.route\")",
        "hide": 0,
        "includeAll": true,
        "multi": false,
        "name": "endpoint",
        "options": [],
        "query": "label_values({__name__=\"http.server.request.duration_seconds_count\"}, \"http.route\")",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "SQL Client & API Performance"
}
