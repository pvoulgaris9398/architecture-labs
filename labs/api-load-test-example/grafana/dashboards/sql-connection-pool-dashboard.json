{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": 1,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "Investigate selected run in Seq",
      "tooltip": "Open Seq with the selected test ID and scenario in a stable one-day search window.",
      "type": "link",
      "url": "http://127.0.0.1:5341/#/events?filter=test_id%20%3D%20%2F${test_id:percentencode}%2F%20and%20scenario%20%3D%20%2F${scenario:percentencode}%2F&range=1d"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "title": "Active Execution Latency (P95 HTTP Request Duration) by Endpoint",
      "type": "timeseries",
      "id": 1,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate({__name__=\"http.server.request.duration_seconds_bucket\", \"http.route\"=~\"$endpoint\"}[1m])) by (le, \"http.route\"))",
          "legendFormat": "P95 - {{http.route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "s"
        }
      },
      "links": [
        {
          "targetBlank": true,
          "title": "Investigate selected run in Seq",
          "url": "http://127.0.0.1:5341/#/events?filter=test_id%20%3D%20%2F${test_id:percentencode}%2F%20and%20scenario%20%3D%20%2F${scenario:percentencode}%2F&range=1d"
        }
      ]
    },

    {
      "title": "Connection Pool: Active vs Free vs Stasis",
      "description": "Active = connections currently in use by the app. Free = available in pool. Stasis = awaiting completion of an action (pool pressure indicator).",
      "type": "timeseries",
      "id": 2,
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "{__name__=\"sqlclient.pool.connections_in_use\"}",
          "legendFormat": "In Use"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "{__name__=\"sqlclient.pool.connections_free\"}",
          "legendFormat": "Free"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "{__name__=\"sqlclient.pool.connections_stasis\"}",
          "legendFormat": "Stasis (pool pressure)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Stasis (pool pressure)" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
            ]
          }
        ]
      }
    },

    {
      "title": "API HTTP Error Rate (Server-side)",
      "description": "API responses split into client errors (4xx) and server errors (5xx). TCP connection failures never reach the API and appear only in the k6 Client Failure Ratio panel. Zero means no API errors only when API Scrape Availability is 1.",
      "type": "stat",
      "id": 3,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(rate({__name__=\"http.server.request.duration_seconds_count\", \"http.route\"=~\"$endpoint\", \"http.response.status_code\"=~\"4..\"}[1m])) or vector(0)",
          "legendFormat": "HTTP 4xx / sec"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(rate({__name__=\"http.server.request.duration_seconds_count\", \"http.route\"=~\"$endpoint\", \"http.response.status_code\"=~\"5..\"}[1m])) or vector(0)",
          "legendFormat": "HTTP 5xx / sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "links": [
        {
          "targetBlank": true,
          "title": "Investigate selected run in Seq",
          "url": "http://127.0.0.1:5341/#/events?filter=test_id%20%3D%20%2F${test_id:percentencode}%2F%20and%20scenario%20%3D%20%2F${scenario:percentencode}%2F&range=1d"
        }
      ]
    },

    {
      "title": "Pool Anomalies: Stasis and Reclaimed Connections",
      "description": "Stasis means a connection is awaiting completion of an action, commonly transaction-related; it is not a count of requests queued for a pool slot. Reclaimed connections indicate SqlConnections collected without Close or Dispose.",
      "type": "timeseries",
      "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "{__name__=\"sqlclient.pool.connections_stasis\"}",
          "legendFormat": "Stasis (queued, blocked)"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "{__name__=\"sqlclient.pool.reclaimed_connections\"}",
          "legendFormat": "Reclaimed by GC (leak indicator)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60 },
          "color": { "mode": "fixed", "fixedColor": "red" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },

    {
      "title": "Physical Connection Churn (Hard Connects / Disconnects per sec)",
      "description": "Hard connects/disconnects should be near zero under steady load — the pool should be reusing soft connections. A spike here means the pool is being exhausted and new physical connections are being opened.",
      "type": "timeseries",
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "{__name__=\"sqlclient.connections.hard_connects\"}",
          "legendFormat": "Hard Connects / sec"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "{__name__=\"sqlclient.connections.hard_disconnects\"}",
          "legendFormat": "Hard Disconnects / sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Hard Disconnects / sec" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }
            ]
          }
        ]
      }
    },

    {
      "title": "Pool Soft Connect/Disconnect Rate (Pool Reuse)",
      "description": "Soft connects/disconnects represent normal pool checkout/return activity. A healthy pool has high soft rates and near-zero hard rates.",
      "type": "timeseries",
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "{__name__=\"sqlclient.pool.soft_connects\"}",
          "legendFormat": "Pool Checkouts / sec"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "{__name__=\"sqlclient.pool.soft_disconnects\"}",
          "legendFormat": "Pool Returns / sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" }
        }
      }
    },

    {
      "title": "Pool Inventory Snapshot",
      "description": "Total pooled connections managed by the driver vs non-pooled (should be 0 unless Pooling=false connections exist).",
      "type": "timeseries",
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "{__name__=\"sqlclient.pool.pooled_connections\"}",
          "legendFormat": "Pooled Connections"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "{__name__=\"sqlclient.pool.non_pooled_connections\"}",
          "legendFormat": "Non-Pooled Connections"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "{__name__=\"sqlclient.connections.active_hard\"}",
          "legendFormat": "Active Physical Connections"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" }
        }
      }
    },

    {
      "title": "API Scrape Availability",
      "description": "Prometheus target availability sampled every five seconds. A brief listener failure between scrapes can still be missed; compare with the k6 client failure panel.",
      "type": "timeseries",
      "id": 8,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "up{job=\"csharp-api\"}",
          "legendFormat": "API up"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 20 }
        }
      }
    },

    {
      "title": "Server Active HTTP Requests",
      "description": "Requests currently executing inside ASP.NET Core. Connection attempts rejected before acceptance are not included.",
      "type": "timeseries",
      "id": 9,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 32 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum({__name__=\"http.server.active_requests\"})",
          "legendFormat": "Active requests"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 20 } } }
    },

    {
      "title": "k6 Client Failure Ratio",
      "description": "Client-observed failures, including TCP connection refusals, when k6 is run through run-k6.sh with Prometheus remote write enabled.",
      "type": "timeseries",
      "id": 10,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 32 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "max({__name__=\"k6_http_req_failed_rate\", test_id=~\"$test_id\", scenario=~\"$scenario\"}) or vector(0)",
          "legendFormat": "Failed request ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "fillOpacity": 30 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      },
      "links": [
        {
          "targetBlank": true,
          "title": "Investigate selected run in Seq",
          "url": "http://127.0.0.1:5341/#/events?filter=test_id%20%3D%20%2F${test_id:percentencode}%2F%20and%20scenario%20%3D%20%2F${scenario:percentencode}%2F&range=1d"
        }
      ]
    },

    {
      "title": "k6 Virtual Users",
      "type": "timeseries",
      "id": 11,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 40 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum({__name__=\"k6_vus\", test_id=~\"$test_id\"}) or vector(0)",
          "legendFormat": "VUs"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 20 } } }
    },

    {
      "title": "k6 Request Rate",
      "type": "timeseries",
      "id": 12,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 40 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(rate({__name__=\"k6_http_reqs_total\", test_id=~\"$test_id\", scenario=~\"$scenario\"}[30s])) or vector(0)",
          "legendFormat": "Requests / sec"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20 } } }
    },

    {
      "title": "Connection Pool Utilization",
      "description": "Connections in use as a percentage of the active connection string's Max Pool Size of 150.",
      "type": "timeseries",
      "id": 13,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 40 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "100 * {__name__=\"sqlclient.pool.connections_in_use\"} / 150",
          "legendFormat": "Pool utilization"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "fillOpacity": 25 }
        }
      }
    },

    {
      "title": "Average SQL Client Operation Duration",
      "description": "Rate-derived average from the OpenTelemetry SQL client duration histogram, grouped by database.",
      "type": "timeseries",
      "id": 14,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 48 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum by (\"db.name\") (rate({__name__=\"db.client.operation.duration_seconds_sum\"}[1m])) / sum by (\"db.name\") (rate({__name__=\"db.client.operation.duration_seconds_count\"}[1m]))",
          "legendFormat": "{{db.name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 15 } } },
      "links": [
        {
          "targetBlank": true,
          "title": "Investigate selected run in Seq",
          "url": "http://127.0.0.1:5341/#/events?filter=test_id%20%3D%20%2F${test_id:percentencode}%2F%20and%20scenario%20%3D%20%2F${scenario:percentencode}%2F&range=1d"
        }
      ]
    },

    {
      "title": "Recent Warning and Error Logs (Seq)",
      "description": "Prometheus does not store logs. Use this launch point to inspect structured warnings and errors for the selected test and scenario in Seq, including HTTP 4xx warnings.",
      "type": "text",
      "id": 15,
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 56 },
      "options": {
        "mode": "markdown",
        "content": "### Detailed warnings and errors live in Seq\n\nSelect `test_id` and `scenario`, then use **Investigate warnings and errors in Seq** from this panel. Filter further with the reported `@TraceId`."
      },
      "links": [
        {
          "targetBlank": true,
          "title": "Investigate warnings and errors in Seq",
          "url": "http://127.0.0.1:5341/#/events?filter=test_id%20%3D%20%2F${test_id:percentencode}%2F%20and%20scenario%20%3D%20%2F${scenario:percentencode}%2F%20and%20%40Level%20in%20%5B%27Warning%27%2C%20%27Error%27%2C%20%27Fatal%27%5D&range=1d"
        }
      ]
    },

    {
      "title": "Representative Traces (Seq)",
      "description": "Prometheus aggregates requests and cannot list individual traces. Open sampled traces in Seq, then select a slow or failed event and use its Trace menu.",
      "type": "text",
      "id": 16,
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 56 },
      "options": {
        "mode": "markdown",
        "content": "### Sampled traces live in Seq\n\nThe Collector retains all errors and requests at least 500 ms, plus samples of ordinary successes. Select a run, open Seq, and pivot from an event to its trace."
      },
      "links": [
        {
          "targetBlank": true,
          "title": "Investigate traces in Seq",
          "url": "http://127.0.0.1:5341/#/events?filter=test_id%20%3D%20%2F${test_id:percentencode}%2F%20and%20scenario%20%3D%20%2F${scenario:percentencode}%2F&range=1d"
        }
      ]
    },

    {
      "title": "Slow API Request Rate (> 500 ms)",
      "description": "Requests exceeding the Collector's 500 ms slow-trace threshold. Zero means no slow requests only when API Scrape Availability is 1; use the Seq trace panel to inspect examples.",
      "type": "timeseries",
      "id": 17,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 62 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "clamp_min(sum(rate({__name__=\"http.server.request.duration_seconds_count\", \"http.route\"=~\"$endpoint\"}[1m])) - sum(rate({__name__=\"http.server.request.duration_seconds_bucket\", \"http.route\"=~\"$endpoint\", le=\"0.5\"}[1m])), 0) or vector(0)",
          "legendFormat": "Slow requests / sec"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 25 } } },
      "links": [
        {
          "targetBlank": true,
          "title": "Investigate selected run in Seq",
          "url": "http://127.0.0.1:5341/#/events?filter=test_id%20%3D%20%2F${test_id:percentencode}%2F%20and%20scenario%20%3D%20%2F${scenario:percentencode}%2F&range=1d"
        }
      ]
    },

    {
      "title": "Database Operation Error Rate",
      "description": "SQL client operations carrying a non-empty quoted \"error.type\" attribute. Zero means no database errors only when API scraping is healthy; use Seq to inspect the correlated exception and SQL span.",
      "type": "timeseries",
      "id": 18,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 62 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum by (\"error.type\") (rate({__name__=\"db.client.operation.duration_seconds_count\", \"error.type\"!=\"\"}[1m])) or vector(0)",
          "legendFormat": "{{error.type}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 25 } } },
      "links": [
        {
          "targetBlank": true,
          "title": "Investigate selected run in Seq",
          "url": "http://127.0.0.1:5341/#/events?filter=test_id%20%3D%20%2F${test_id:percentencode}%2F%20and%20scenario%20%3D%20%2F${scenario:percentencode}%2F&range=1d"
        }
      ]
    },

    {
      "title": "Collector Availability and Seq Export Queue",
      "description": "Collector scrape availability and Seq exporter queue utilization. Availability below 1 means telemetry visibility is degraded. A sustained queue increase means Seq export cannot keep up or Seq is unavailable.",
      "type": "timeseries",
      "id": 19,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 70 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "up{job=\"otel-collector\"}",
          "legendFormat": "Collector available (1=yes)"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "100 * sum({__name__=\"otelcol_exporter_queue_size\", exporter=\"otlphttp/seq\"}) / clamp_min(sum({__name__=\"otelcol_exporter_queue_capacity\", exporter=\"otlphttp/seq\"}), 1)",
          "legendFormat": "Seq export queue utilization %"
        }
      ],
      "fieldConfig": { "defaults": { "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 20 } } }
    },

    {
      "title": "Collector Refused, Failed, or Prematurely Dropped Telemetry",
      "description": "Pipeline-loss indicators, excluding deliberate tail-sampling decisions. Any value above zero needs investigation. Zero is trustworthy only while Collector availability is 1; the zero fallback must not conceal an unavailable Collector.",
      "type": "timeseries",
      "id": 20,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 70 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "(sum(rate(otelcol_receiver_refused_spans[1m])) or vector(0)) + (sum(rate(otelcol_receiver_refused_log_records[1m])) or vector(0)) + (sum(rate(otelcol_receiver_refused_metric_points[1m])) or vector(0))",
          "legendFormat": "Receiver refused / sec"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "(sum(rate(otelcol_receiver_failed_spans[1m])) or vector(0)) + (sum(rate(otelcol_receiver_failed_log_records[1m])) or vector(0)) + (sum(rate(otelcol_receiver_failed_metric_points[1m])) or vector(0))",
          "legendFormat": "Receiver failed / sec"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(rate({__name__=\"otelcol_processor_tail_sampling_sampling_trace_dropped_too_early\"}[1m])) or vector(0)",
          "legendFormat": "Trace dropped before decision / sec"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0, "custom": { "drawStyle": "bars", "fillOpacity": 40 } } }
    },

    {
      "title": "Host Storage Free (C:)",
      "description": "Free space on the Windows volume that normally backs Docker Desktop data. Keep at least 10 GiB free per the lab guardrail. No data means optional windows_exporter is unavailable—not that storage is healthy. Seq and Prometheus volume usage must still be checked directly during Step 9.",
      "type": "timeseries",
      "id": 21,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 78 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "{__name__=\"windows_logical_disk_free_bytes\", volume=\"C:\"}",
          "legendFormat": "C: free bytes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 20 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 10737418240 }
            ]
          }
        }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["sql-server", "opentelemetry", "dotnet"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus" },
        "definition": "label_values({__name__=\"http.server.request.duration_seconds_count\"}, \"http.route\")",
        "hide": 0,
        "includeAll": true,
        "multi": false,
        "name": "endpoint",
        "options": [],
        "query": "label_values({__name__=\"http.server.request.duration_seconds_count\"}, \"http.route\")",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus" },
        "definition": "label_values({__name__=\"k6_http_reqs_total\"}, test_id)",
        "hide": 0,
        "includeAll": true,
        "multi": false,
        "name": "test_id",
        "options": [],
        "query": "label_values({__name__=\"k6_http_reqs_total\"}, test_id)",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 2,
        "type": "query"
      },
      {
        "allValue": ".*",
