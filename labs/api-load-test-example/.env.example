# Copy this file to .env before starting the stack. Never commit .env.
MSSQL_SA_PASSWORD=Replace-with-a-strong-local-password1!
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=Replace-with-a-local-password1!
SEQ_ADMIN_USER=admin
SEQ_ADMIN_PASSWORD=Replace-with-a-different-local-password1!
API_HOST_PORT=18080
SEQ_HOST_PORT=5341

# Request errors are always logged. Enable these only for focused diagnostics; successful or slow
# per-request logs can generate substantial output during a load test.
LOG_SUCCESSFUL_REQUESTS=false
LOG_SLOW_REQUESTS=false
SLOW_REQUEST_THRESHOLD_MS=500

# Keep true for normal lab operation. The Step 9 A/B procedure temporarily sets this to false to
# measure the cost of OTLP trace, log, and metric export while preserving Prometheus scraping.
TELEMETRY_OTLP_ENABLED=true

# Explicit versions keep demo runs reproducible. Upgrade these deliberately.
SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2025-latest
PROMETHEUS_IMAGE=prom/prometheus:v3.5.5
GRAFANA_IMAGE=grafana/grafana:13.1.1
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.157.0
SEQ_IMAGE=datalust/seq:2026.1.17004-x64

# The Compose default sends API telemetry to the collector over the internal network. Override this
# only when intentionally testing another collector. Prometheus still scrapes the API directly.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY=in_memory

# Host-side diagnostic ports; container-to-container traffic uses the standard internal ports.
OTEL_GRPC_HOST_PORT=14317
OTEL_HTTP_HOST_PORT=14318
OTEL_HEALTH_HOST_PORT=13133
OTEL_METRICS_HOST_PORT=18888

# Bound the API SDK's asynchronous trace and log export queues. In-memory retry handles transient
# OTLP failures without persisting telemetry; export failures must not block API request handling.
OTEL_BSP_MAX_QUEUE_SIZE=4096
OTEL_BSP_EXPORT_TIMEOUT=5000
OTEL_BLRP_MAX_QUEUE_SIZE=4096
OTEL_BLRP_EXPORT_TIMEOUT=5000
